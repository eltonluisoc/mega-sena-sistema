rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'eltonluisoc@gmail.com';
    }

    // Cartões, resultados oficiais, configuração e bolões: leitura
    // pública necessária porque index.html, consulta.html, meus-boloes.html
    // e admin.html leem o Firestore direto do navegador, sem backend
    // intermediário. Escrita/exclusão exigem o admin autenticado.
    //
    // "cartoes" — App Check (request.app != null) foi TENTADO aqui na
    // Rodada 106 e revertido na hora: assim que ativado, o site público
    // de verdade parou de mostrar os cartões (usuário confirmou ao
    // testar ao vivo) — bate com o risco já levantado antes de deployar
    // (a chave "Fraud Defense"/reCAPTCHA Enterprise parece ter sido
    // criada num projeto Google Cloud diferente de mega-sena-sistema,
    // ?project=97295189433 vs messagingSenderId 134457862979 do
    // firebase-config.js). Volta a ser leitura 100% aberta até a causa
    // ser corrigida (recriar a chave garantindo o projeto certo) e
    // validada de novo, com mais cuidado, antes de reativar a exigência.
    match /cartoes/{document} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /resultados_mega/{document} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /resultados_lotofacil/{document} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /resultados_quina/{document} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /config_boloes/{document} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /config_geral/{document} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /participantes_pendentes/{document} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // Cache de resultados oficiais das loterias, hoje gravado só pelo
    // admin (conferirComoAdmin, admin.js) — a gravação pública foi
    // removida do site faz tempo (script.js só lê). Achado real
    // (03/11): como só o admin cria, dá pra exigir isAdmin() direto no
    // create, sem precisar mais da trava antiga de
    // config_geral/conferencia_bloqueio (ela só existia pra impedir um
    // visitante de criar o doc do concurso mais recente antes do
    // admin — um caminho que não existe mais).
    //
    // Pedido do usuário (03/11): conferir e publicar viram 2 momentos
    // diferentes — o admin confere primeiro (privado), só publica
    // quando decidir. O campo `publicado` controla isso: só quem pode
    // ler um doc ainda não publicado é o próprio admin. script.js (site
    // público) já trata qualquer erro de leitura (inclusive um futuro
    // PERMISSION_DENIED aqui) exatamente como "ainda não conferido" —
    // confirmado lendo o código, não muda nada lá.
    match /resultados_conferidos/{document} {
      // Achado real do usuário (07/11): documentos ANTIGOS (conferidos
      // antes da Rodada 127, quando "publicado" nem existia) ficaram
      // invisíveis pro público — o padrão de "campo ausente" era false
      // (privado). Corrigido: campo ausente = documento antigo = já
      // era público antes dessa funcionalidade existir, continua
      // público (default true). Só um documento com "publicado"
      // GRAVADO como false (os novos, de conferirComoAdmin) fica
      // privado de verdade — é exatamente o caso que essa funcionalidade
      // precisa cobrir.
      allow get: if resource.data.get('publicado', true) == true || isAdmin();
      allow list: if isAdmin();
      // 'trevos' é opcional (só +Milionária usa) — hasOnly só limita quais
      // chaves PODEM existir, não exige que todas estejam presentes, então
      // documentos das outras 3 loterias (sem trevos) continuam válidos.
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(
                        ['loteria','concurso','numeros','trevos','dataConferencia','dataSorteio','conferido','admin','publicado','dataPublicacao'])
                    && request.resource.data.loteria in ['mega','lotofacil','quina','maismilionaria']
                    && request.resource.data.numeros is list
                    && request.resource.data.numeros.size() > 0
                    && request.resource.data.numeros.size() <= 20
                    && (!('trevos' in request.resource.data) || (request.resource.data.trevos is list && request.resource.data.trevos.size() == 2))
                    && request.resource.data.conferido == true
                    && request.resource.data.publicado is bool;
      allow update, delete: if isAdmin();
    }

    // participantes: exposição de dado pessoal conhecida (Rodada 56),
    // MITIGADA de graça na Rodada 60 sem Cloud Function nem plano pago
    // (usuário recusou o Blaze — nem Storage nem Functions funcionam no
    // Spark). Solução: get() e list() são permissões SEPARADAS no
    // Firestore. participantes.html já lia UM documento por ID (get,
    // nunca foi o problema); quem baixava a coleção INTEIRA (list) pra
    // filtrar no navegador era só consulta.js/consulta.html — e essas
    // duas páginas agora leem busca_participante (abaixo) em vez desta
    // coleção. Então dá pra travar list() de vez sem quebrar nada:
    // ninguém mais baixa "participantes" inteira, nem pelo console do
    // navegador — só o admin autenticado (admin.js ainda lista tudo
    // pra gerenciar). chave_pix nunca esteve nesta coleção (confirmado
    // lendo o único escritor, enviar_bolao_para_site() no desktop).
    match /participantes/{document} {
      allow get: if true;
      allow list: if isAdmin();
      allow write, delete: if isAdmin();
    }

    // busca_participante: 1 documento por TELEFONE (chave = só
    // dígitos), com a lista dos bolões daquela pessoa — criado na
    // Rodada 60 especificamente pra consulta.js/consulta.html poderem
    // buscar UM telefone (get, sempre liberado) sem precisar de list()
    // em "participantes". list() aqui fica travado de vez: ninguém
    // busca "todo mundo que tem telefone cadastrado" de uma vez, só
    // telefone individual que a própria pessoa digitou.
    match /busca_participante/{telefone} {
      allow get: if true;
      allow list: if false;
      allow write, delete: if isAdmin();
    }

    // participantes_tokens precisa continuar com leitura de UM documento
    // (get) pública, porque consulta.html verifica o token do visitante
    // assim. Mas listar (list) a coleção inteira expõe todos os tokens
    // válidos + nome + telefone de uma vez — a regra genérica antiga
    // permitia isso sem querer. Restringe list ao admin autenticado.
    match /participantes_tokens/{document} {
      allow get: if true;
      allow list: if isAdmin();
      allow write, delete: if isAdmin();
    }

    // reservas_participantes é dado financeiro nominal e só é lido pelo
    // admin (nenhuma página pública consulta essa coleção) — não faz
    // sentido deixar leitura pública aqui, nem get nem list.
    //
    // Modelo novo (sincronização ao vivo, sem fila de pendências —
    // substitui reservas_movimentos_pendentes abaixo, que fica só até a
    // migração terminar de esvaziá-la): o saldo (`saldoReserva`) só
    // muda por incremento atômico, junto com a criação do lançamento
    // correspondente em movimentos/ — nunca mais reescrito por inteiro
    // a partir de uma cópia local (essa reescrita era a causa raiz de
    // web e desktop divergirem quando gravavam perto um do outro). O
    // campo `historico` (array antigo, reescrito por inteiro a cada
    // sync) não pode mais aparecer — é exatamente o padrão que está
    // sendo substituído pela subcoleção `movimentos` abaixo.
    match /reservas_participantes/{pessoaId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.keys().hasOnly(
                         ['participanteId','nome','telefone','chavePix',
                          'observacoes','ativo','saldoReserva','dataAtualizacao','admin',
                          'qualificaAlertaSaldoBaixo','alertaSaldoBaixoStatus',
                          'alertaSaldoBaixoDesde','alertaSaldoBaixoEnviadoEm'])
                    && request.resource.data.saldoReserva == 0;
      allow update: if isAdmin()
                    && !('historico' in request.resource.data)
                    && request.resource.data.keys().hasOnly(
                         ['participanteId','nome','telefone','chavePix',
                          'observacoes','ativo','saldoReserva','dataAtualizacao','admin',
                          'qualificaAlertaSaldoBaixo','alertaSaldoBaixoStatus',
                          'alertaSaldoBaixoDesde','alertaSaldoBaixoEnviadoEm']);
      allow delete: if isAdmin();

      // Ledger só-de-inserção: um documento por depósito/saque, nunca
      // editado nem apagado (nem pelo admin) — um engano vira um
      // lançamento reverso novo, nunca uma edição do passado. `movId`
      // é gerado pelo cliente (UUID no desktop, doc().id no site) e
      // serve de chave de idempotência contra gravação duplicada depois
      // de uma falha de rede ambígua.
      //
      // criadoEm aceita qualquer timestamp (não só request.time): a
      // migração que preenche o ledger a partir do histórico local
      // precisa gravar a data ORIGINAL de cada lançamento antigo, não
      // "agora". Não há um boundary de segurança real sendo afrouxado
      // aqui — os dois únicos escritores (site e desktop) já são o
      // mesmo admin autenticado; isso só garante o formato do campo.
      match /movimentos/{movId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
                      && request.resource.data.keys().hasOnly(
                           ['tipo','valor','data','descricao','loteria',
                            'concurso','origem','criadoEm'])
                      && request.resource.data.tipo in ['deposito','saque']
                      && request.resource.data.valor is number
                      && request.resource.data.valor > 0
                      && request.resource.data.origem in ['web','desktop','migracao']
                      && request.resource.data.criadoEm is timestamp;
        allow update, delete: if false;
      }
    }

    // Contador global incrementado atomicamente em toda gravação de
    // reserva (web ou desktop) — é só isso que o desktop fica
    // verificando em segundo plano (a cada poucos segundos) pra saber
    // "mudou algo, hora de buscar de novo", em vez de reler a coleção
    // inteira toda hora.
    match /meta/reservas_version {
      allow read: if isAdmin();
      allow write: if isAdmin()
                   && request.resource.data.keys().hasOnly(['versao','atualizadoEm'])
                   && request.resource.data.versao is int;
    }

    // Alerta de saldo baixo (03/11) — coleção ANTIGA, substituída (07/11)
    // por 3 campos direto em reservas_participantes/{pessoaId}
    // (alertaSaldoBaixoStatus/Desde/EnviadoEm) pra não precisar mais ler
    // essa coleção inteira a cada carregamento de Reservas (ela só
    // crescia — uma das causas do estouro de cota do Firestore). Mantida
    // só de leitura, pro script de migração pontual que porta os
    // alertas pendentes antigos pros campos novos; nada no app grava
    // aqui mais.
    match /alertas_saldo_baixo/{document} {
      allow read, write: if isAdmin();
    }

    // Fila ANTIGA de depósitos/saques de reserva (modelo substituído
    // pela sincronização ao vivo acima) — mantida só até a migração
    // esvaziá-la de vez; depois disso este bloco é removido.
    match /reservas_movimentos_pendentes/{document} {
      allow read, write: if isAdmin();
    }

    // Fila de premiações registradas pelo admin no site, aguardando o
    // app desktop abrir e importar pra tabela local `premiacoes` (é o
    // desktop que mantém o histórico completo de premiações — o site só
    // empilha aqui até ser importado, depois o documento é apagado).
    // Mesmo padrão/mesmo motivo de reservas_movimentos_pendentes acima —
    // pedido do usuário: "quero informar no admin... e quero que o
    // sistema desktop atualize a premiação na aba gestão premiações".
    match /premiacoes_pendentes/{document} {
      allow read, write: if isAdmin();
    }

    // Gerações salvas do Otimizador de Cotas (app desktop separado,
    // D:\PROJETOS\OTIMIZADOR_COTAS) — sincronizadas aqui só pra
    // VISUALIZAÇÃO no admin.html (decisão explícita do usuário: gerar
    // continua só no app desktop, 1 motor de cálculo só). Nenhuma página
    // pública lê isso — é dado de planejamento interno do organizador do
    // bolão, não de participantes — então leitura/escrita ficam
    // restritas ao admin autenticado, mesmo padrão de
    // reservas_movimentos_pendentes acima.
    match /otimizador_cotas_geracoes/{document} {
      allow read, write: if isAdmin();
    }
  }
}
