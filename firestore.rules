rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'eltonluisoc@gmail.com';
    }

    // Cartões, resultados oficiais, configuração e bolões: leitura
    // pública necessária porque index.html, consulta.html, meus-boloes.html
    // e admin.html leem o Firestore direto do navegador, sem backend
    // intermediário. Escrita/exclusão exigem o admin autenticado.
    match /cartoes/{document} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /resultados_mega/{document} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /resultados_lotofacil/{document} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /resultados_quina/{document} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /config_boloes/{document} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /config_geral/{document} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }
    match /participantes_pendentes/{document} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // Cache de resultados oficiais das loterias: gravado pelo público
    // (script.js) na primeira vez que alguém confere um concurso no site
    // (o app não tem backend próprio pra validar contra a API oficial da
    // Caixa antes de gravar). Só a CRIAÇÃO é pública — depois de gravado,
    // só o admin pode alterar/apagar. Sem isso, qualquer visitante podia
    // sobrescrever o resultado de um concurso já conferido com números
    // forjados a qualquer momento, e o site passava a confiar cegamente
    // nesse cache pra todo mundo (inclusive pra decidir quem "ganhou").
    match /resultados_conferidos/{document} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                        ['loteria','concurso','numeros','dataConferencia','dataSorteio','conferido','admin'])
                    && request.resource.data.loteria in ['mega','lotofacil','quina']
                    && request.resource.data.numeros is list
                    && request.resource.data.numeros.size() > 0
                    && request.resource.data.numeros.size() <= 20
                    && request.resource.data.conferido == true;
      allow update, delete: if isAdmin();
    }

    // participantes ainda precisa de leitura pública total (nome,
    // telefone, valorPago, situação, cotas) porque consulta.html/
    // meus-boloes.html buscam a coleção INTEIRA e filtram no navegador
    // — exposição de dado pessoal conhecida, reavaliada na Rodada 56
    // (usuário pediu mitigação; investigado a fundo antes de mexer):
    //
    //  - chave_pix NÃO está nesta coleção (só nome/telefone/valorPago/
    //    situacao/quantidadeCotas/dataCadastro — confirmado lendo o
    //    único escritor, enviar_bolao_para_site() no desktop).
    //  - Uma regra do Firestore não consegue restringir ISSO sem
    //    quebrar a busca: o dado é um doc POR BOLÃO com um array de
    //    participantes dentro (não um doc por pessoa), então não dá
    //    pra fazer uma query "where telefone == X" no servidor — o
    //    cliente PRECISA baixar o array inteiro pra filtrar. Regras do
    //    Firestore decidem "pode ler este documento inteiro ou não",
    //    não "pode ler só os itens do array que batem com X".
    //  - Tirar valorPago/dataCadastro do documento reduziria a
    //    exposição, mas quebraria a própria pessoa consultando SEU
    //    PRÓPRIO valor pago — não dá pra distinguir "sou eu vendo meu
    //    dado" de "sou outro vendo o de todo mundo" sem autenticação.
    //
    //  Mitigação real exige um dos dois:
    //   (a) Cloud Function callable que recebe telefone como parâmetro
    //       e devolve só os bolões DAQUELE telefone (servidor filtra,
    //       cliente nunca baixa a coleção inteira) — não prova que
    //       quem pergunta é o dono do número (precisaria de OTP por
    //       SMS pra isso), mas elimina o scraping em massa de todo
    //       mundo de uma vez, que é o risco real hoje.
    //   (b) Restruturar "participantes" pra 1 documento por PESSOA
    //       (não por bolão), indexado por telefone normalizado — aí sim
    //       uma query where() nativa filtra no servidor.
    //  Infraestrutura de Cloud Functions já existe e funciona
    //  (functions/functions/) — (a) é o caminho mais barato dos dois.
    match /participantes/{document} {
      allow read: if true;
      allow write, delete: if isAdmin();
    }

    // participantes_tokens precisa continuar com leitura de UM documento
    // (get) pública, porque consulta.html verifica o token do visitante
    // assim. Mas listar (list) a coleção inteira expõe todos os tokens
    // válidos + nome + telefone de uma vez — a regra genérica antiga
    // permitia isso sem querer. Restringe list ao admin autenticado.
    match /participantes_tokens/{document} {
      allow get: if true;
      allow list: if isAdmin();
      allow write, delete: if isAdmin();
    }

    // reservas_participantes é dado financeiro nominal e só é lido pelo
    // admin (nenhuma página pública consulta essa coleção) — não faz
    // sentido deixar leitura pública aqui, nem get nem list.
    match /reservas_participantes/{document} {
      allow read: if isAdmin();
      allow write, delete: if isAdmin();
    }

    // Fila de depósitos/saques de reserva registrados pelo admin no site,
    // aguardando o app desktop abrir e importar pro SQLite local (é o
    // desktop que mantém o histórico completo — o site só empilha aqui até
    // ser importado, depois o documento é apagado). Só o admin toca nisso,
    // dos dois lados (site e desktop usam a mesma conta).
    match /reservas_movimentos_pendentes/{document} {
      allow read, write: if isAdmin();
    }
  }
}
